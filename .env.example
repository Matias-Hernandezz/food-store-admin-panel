# URL base del backend (FastAPI)
VITE_API_URL=http://localhost:8000

# MercadoPago Public Key (para SDK frontend)
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxx

# Slug del local (multi-tenant). Header X-Tenant-Slug hacia la API.
# VITE_TENANT_SLUG=demo

# URL de la tienda cliente (links modo repartidor en pedidos)
# VITE_CLIENT_APP_URL=http://localhost:5174
